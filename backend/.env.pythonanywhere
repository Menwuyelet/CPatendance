# PythonAnywhere Environment Configuration
# Copy this file to .env on PythonAnywhere and fill in the values

# Django Secret Key - Generate a new one for production!
# You can generate one at: https://djecrety.ir/
DJANGO_SECRET_KEY=your-secret-key-here

# Debug Mode - MUST be False in production
DJANGO_DEBUG=False

# Allowed Hosts - Add your PythonAnywhere domain
# Format: yourusername.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourusername.pythonanywhere.com,.pythonanywhere.com

# Database Path (PythonAnywhere uses SQLite by default)
# This will be automatically created in your project directory
DJANGO_DB_PATH=/home/yourusername/CPatendance/backend/db.sqlite3

# Biometric Encryption Key - KEEP THIS SECRET!
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_SECRET_KEY=-iXAOkcJoFyq58EXoeskOOfltPP6qrm_4vCnTbc_o-c=

