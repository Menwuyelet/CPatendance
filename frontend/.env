# Frontend environment configuration
# This file is used by Vite to configure the dev server proxy

# Frontend will call this base URL.
# Keep '/api' to use the Vite dev-server proxy (recommended for local dev).
VITE_API_BASE_URL=/api

# Where Vite should proxy /api/* requests.
# Point this at wherever your backend is running.
VITE_PROXY_TARGET=http://127.0.0.1:8000
