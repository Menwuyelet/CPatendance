# Netlify Deployment Environment Variables
# Copy these to Netlify site settings: Site Settings → Build & Deploy → Environment

# Backend API URL - change to your actual backend URL
VITE_API_BASE_URL=https://your-backend-url.com/api

# Environment
VITE_ENV=production

# Analytics (optional)
VITE_ANALYTICS_ID=

# Feature flags
VITE_ENABLE_BIOMETRICS=true
VITE_ENABLE_REPORTS=true
