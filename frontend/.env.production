# Netlify Deployment Environment Variables
# Copy these to Netlify site settings: Site Settings → Build & Deploy → Environment

# Use Netlify proxy (see netlify.toml) so the browser calls same-origin `/api/...`
VITE_API_BASE_URL=/api

# Environment
VITE_ENV=production

# Analytics (optional)
VITE_ANALYTICS_ID=

# Feature flags
VITE_ENABLE_BIOMETRICS=true
VITE_ENABLE_REPORTS=true
